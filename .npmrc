# pnpm + npm config shared by every contributor.
# This file is committed. Never put auth tokens here.
# Local auth lives in ~/.npmrc or CI secrets (NPM_TOKEN).

# --- registry ---
registry=https://registry.npmjs.org/
@caboc:registry=https://registry.npmjs.org/

# --- engine + package manager enforcement ---
engine-strict=true
package-manager-strict=true

# --- workspace resolution (pnpm) ---
link-workspace-packages=true
prefer-workspace-packages=true
resolve-peers-from-workspace-root=true
auto-install-peers=true
strict-peer-dependencies=false

# --- version pinning ---
save-exact=false
save-prefix=^
resolution-mode=highest

# --- safety + signing ---
audit-level=high
fund=false
update-notifier=false
provenance=true

# --- script discipline ---
enable-pre-post-scripts=true
ignore-scripts=false

# --- logging ---
loglevel=warn

# --- publish defaults for scoped packages ---
access=public
tag=next

# --- editorial ---
git-tag-version=false
commit-hooks=false
