{
	"name": "caboc",
	"version": "0.0.0",
	"private": true,
	"description": "CABOC — Common AI Business Oriented Convention. Markdown-only DSL for LLM workflows.",
	"license": "Apache-2.0",
	"homepage": "https://github.com/caboc/caboc",
	"repository": {
		"type": "git",
		"url": "https://github.com/caboc/caboc.git"
	},
	"bugs": {
		"url": "https://github.com/caboc/caboc/issues"
	},
	"author": "CABOC contributors",
	"type": "module",
	"engines": {
		"node": ">=20.10.0"
	},
	"packageManager": "pnpm@9.12.3",
	"workspaces": [
		"packages/*",
		"skills/*",
		"examples/*"
	],
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "pnpm -r --if-present run typecheck",
		"test": "pnpm -r --if-present run test",
		"build": "pnpm -r --if-present run build",
		"clean": "pnpm -r --if-present run clean"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"typescript": "^5.6.0"
	}
}
